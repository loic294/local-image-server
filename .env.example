# Server Configuration
PORT=3000

# Image Directory
# Path to the directory containing JPG images
IMAGE_DIR=/images

# Image Filtering
# Set to 'true' to only select horizontal images (width > height)
ONLY_HORIZONTAL=false

# Logging
# Options: error, warn, info, debug
LOG_LEVEL=info

# Cache Configuration
# Time in milliseconds to cache the list of image files
SCAN_CACHE_TTL=60000
