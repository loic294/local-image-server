# Server Configuration
PORT=3000

# Image Directory
# Path to the directory containing JPG images
IMAGE_DIR=/images

# Image Filtering
# Set to 'true' to only select horizontal images (width > height)
ONLY_HORIZONTAL=false

# Skip Patterns
# Comma-separated list of strings to skip files/directories containing them
# Uses substring matching (e.g., "temp" matches both "/temp/" and "/temperature/")
# Example: SKIP_PATTERNS=.backup,thumbnail,temp
# This will skip any file or directory whose path contains ".backup", "thumbnail", or "temp"
SKIP_PATTERNS=

# Logging
# Options: error, warn, info, debug
LOG_LEVEL=info

# Cache Configuration
# Time in milliseconds to cache the list of image files
SCAN_CACHE_TTL=60000
